# Copy to /etc/harga-toko/worker.env (chmod 600). Never commit the real file.

# Supabase > Project Settings > Database > Connection string > "Session pooler".
# The direct db.<ref>.supabase.co address is IPv6-only on most plans.
DATABASE_URL=postgresql://postgres.gculrkdumuuejsiqsniq:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://gculrkdumuuejsiqsniq.supabase.co

# Supabase > Project Settings > API Keys > service_role (legacy) or a secret key
# (sb_secret_...). This key bypasses all security: worker only, never the app.
SUPABASE_SERVICE_KEY=

# fake = fixed sample data (Milestone 4). ollama / cloud come in Milestone 5.
EXTRACTOR=fake

# Optional
# POLL_INTERVAL=3s
# JOB_TIMEOUT=3m
# WORKER_ID=ubuntu-1
