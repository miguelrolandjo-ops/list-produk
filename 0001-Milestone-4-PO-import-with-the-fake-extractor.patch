+          content: Text(
+            paths.length == 1
+                ? 'Foto PO diterima'
+                : 'PO dengan ${paths.length} halaman diterima',
+          ),
+        ),
+      );
+    } on Object catch (e) {
+      _messenger.currentState?.showSnackBar(
