+                    children: [
+                      Expanded(
+                        child: _AddButton(
+                          icon: Icons.photo_camera_outlined,
+                          label: 'Kamera',
+                          onTap: _adding ? null : _camera,
+                        ),
+                      ),
+                      const SizedBox(width: 10),
+                      Expanded(
+                        child: _AddButton(
