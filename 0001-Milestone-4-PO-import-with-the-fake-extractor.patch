diff --git a/worker/internal/testdb/testdb.go b/worker/internal/testdb/testdb.go
new file mode 100644
index 0000000..afc6b43
--- /dev/null
+++ b/worker/internal/testdb/testdb.go
@@ -0,0 +1,99 @@
+// Package testdb gives tests a Postgres database with the app's server schema.
+//
+// Set TEST_DATABASE_URL to run them; without it the database tests are
+// skipped. Two ways:
+//
+//   - Local Supabase (`supabase start` in the repo root, migrations applied):
+//     TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
+//   - Any plain Postgres 15+: the schema is applied on first use, with small
+//     stand-ins for Supabase's auth and storage schemas.
+//
+// Tests empty the tables they use. Never point this at the real project.
+package testdb
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+// Stand-ins for what Supabase provides, only as much as 0001_init.sql needs.
+const supabaseStubs = `
+create schema if not exists auth;
+create table if not exists auth.users (id uuid primary key);
+create or replace function auth.uid() returns uuid language sql stable as
+  $$ select nullif(current_setting('request.jwt.claim.sub', true), '')::uuid $$;
+create schema if not exists storage;
+create table if not exists storage.objects (
+  id uuid primary key default gen_random_uuid(), bucket_id text, name text);
+create or replace function storage.foldername(name text) returns text[]
+  language sql immutable as
+  $$ select (string_to_array(name, '/'))[1:array_length(string_to_array(name, '/'), 1) - 1] $$;
+`
+
+// Open connects, applies the schema if it is missing, and empties the tables.
+func Open(t *testing.T) *pgxpool.Pool {
+	t.Helper()
+	url := os.Getenv("TEST_DATABASE_URL")
+	if url == "" {
+		t.Skip("TEST_DATABASE_URL not set; skipping database test")
+	}
+	ctx := context.Background()
+	cfg, err := pgxpool.ParseConfig(url)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Same mode as the worker uses in production.
+	cfg.ConnConfig.DefaultQueryExecMode = pgx.QueryExecModeSimpleProtocol
+	pool, err := pgxpool.NewWithConfig(ctx, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(pool.Close)
+
+	var exists bool
+	if err := pool.QueryRow(ctx,
+		`select to_regclass('public.extraction_jobs') is not null`).Scan(&exists); err != nil {
+		t.Fatal(err)
+	}
+	if !exists {
+		if _, err := pool.Exec(ctx, supabaseStubs); err != nil {
+			t.Fatalf("stubs: %v", err)
+		}
+		sql, err := os.ReadFile(migrationPath())
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := pool.Exec(ctx, string(sql)); err != nil {
+			t.Fatalf("migration: %v", err)
+		}
+	}
+	if _, err := pool.Exec(ctx,
+		`truncate extraction_jobs, invites, catalog_items, store_members, stores cascade`); err != nil {
+		t.Fatal(err)
+	}
+	return pool
+}
+
+// NewStore inserts a store and returns its id.
+func NewStore(t *testing.T, pool *pgxpool.Pool) string {
+	t.Helper()
+	var id string
+	if err := pool.QueryRow(context.Background(),
+		`insert into stores (name) values ('Toko Uji') returning id::text`).Scan(&id); err != nil {
+		t.Fatal(err)
+	}
+	return id
+}
+
+func migrationPath() string {
+	_, file, _, _ := runtime.Caller(0)
+	// worker/internal/testdb -> repo root
+	root := filepath.Join(filepath.Dir(file), "..", "..", "..")
+	return filepath.Join(root, "supabase", "migrations", "0001_init.sql")
+}
diff --git a/worker/job/runner.go b/worker/job/runner.go
new file mode 100644
index 0000000..527e0db
--- /dev/null
+++ b/worker/job/runner.go
@@ -0,0 +1,165 @@
+// Package job runs one extraction job at a time: claim it from the queue,
+// download its pages, extract, store the result, delete the pages.
+//
+// The PO photos only live on the server while they are being read. They are
+// deleted as soon as a job is done, and also when it has failed for good.
+package job
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"log/slog"
+	"time"
+
+	"listproduk/worker/extractor"
+)
+
+// MaxAttempts is how often a job is tried before it is marked failed.
+const MaxAttempts = 3
+
+// Job is a claimed extraction job.
+type Job struct {
+	ID        string
+	StoreID   string
+	PagePaths []string // paths in the 'po-images' bucket, in page order
+	Attempts  int      // including the current one
+}
+
+// Queue is the extraction_jobs table (see package queue).
+type Queue interface {
+	// Claim takes the oldest pending job, or returns nil when there is none.
+	Claim(ctx context.Context, workerID string) (*Job, error)
+	Complete(ctx context.Context, id string, result []byte) error
+	// Fail records the error. With retry the job goes back to pending,
+	// otherwise it is failed for good.
+	Fail(ctx context.Context, id string, msg string, retry bool) error
+	// Release puts a job back without counting the attempt (shutdown).
+	Release(ctx context.Context, id string) error
+}
+
+// Images is the 'po-images' bucket (see package storage).
+type Images interface {
+	Download(ctx context.Context, path string) ([]byte, error)
+	Delete(ctx context.Context, paths []string) error
+}
+
+// ErrPermanent marks failures that a retry cannot fix (a page that no longer
+// exists). Such jobs fail at once instead of after MaxAttempts tries.
+var ErrPermanent = errors.New("permanent")
+
+// Runner processes jobs. One Runner handles one job at a time; run several
+// workers for more throughput, the queue hands each job to only one of them.
+type Runner struct {
+	Queue     Queue
+	Images    Images
+	Extractor extractor.Extractor
+	WorkerID  string
+	// JobTimeout bounds downloading and extracting one job. Zero = no limit.
+	JobTimeout time.Duration
+	Log        *slog.Logger
+}
+
+func (r *Runner) logger() *slog.Logger {
+	if r.Log != nil {
+		return r.Log
+	}
+	return slog.Default()
+}
+
+// ProcessOne handles the next pending job. It reports whether there was one,
+// so the caller knows to ask again at once rather than wait. The returned
+// error is about the queue itself; a job that fails is recorded on the job.
+func (r *Runner) ProcessOne(ctx context.Context) (bool, error) {
+	j, err := r.Queue.Claim(ctx, r.WorkerID)
+	if err != nil {
+		return false, fmt.Errorf("claim: %w", err)
+	}
+	if j == nil {
+		return false, nil
+	}
+	log := r.logger().With("job", j.ID, "attempt", j.Attempts, "pages", len(j.PagePaths))
+	log.Info("job claimed")
+
+	result, procErr := r.process(ctx, j)
+
+	// Stopping (Ctrl+C, deploy) is not the job's fault: put it back as it was.
+	// The context is cancelled, so the queue call gets a fresh one.
+	if ctx.Err() != nil {
+		bg, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		defer cancel()
+		if err := r.Queue.Release(bg, j.ID); err != nil {
+			return true, fmt.Errorf("release on shutdown: %w", err)
+		}
+		log.Info("job released on shutdown")
+		return true, nil
+	}
+
+	if procErr == nil {
+		if err := r.Queue.Complete(ctx, j.ID, result); err != nil {
+			return true, fmt.Errorf("complete: %w", err)
+		}
+		r.deletePages(ctx, log, j)
+		log.Info("job done")
+		return true, nil
+	}
+
+	final := j.Attempts >= MaxAttempts || errors.Is(procErr, ErrPermanent)
+	if err := r.Queue.Fail(ctx, j.ID, procErr.Error(), !final); err != nil {
+		return true, fmt.Errorf("fail: %w", err)
+	}
+	if final {
+		r.deletePages(ctx, log, j)
+		log.Warn("job failed for good", "err", procErr)
+	} else {
+		log.Warn("job failed, will retry", "err", procErr)
+	}
+	return true, nil
+}
+
+// process downloads the pages and extracts. The result is validated JSON.
+func (r *Runner) process(ctx context.Context, j *Job) ([]byte, error) {
+	if r.JobTimeout > 0 {
+		var cancel context.CancelFunc
+		ctx, cancel = context.WithTimeout(ctx, r.JobTimeout)
+		defer cancel()
+	}
+	if len(j.PagePaths) == 0 {
+		return nil, fmt.Errorf("job has no pages: %w", ErrPermanent)
+	}
+	pages := make([][]byte, 0, len(j.PagePaths))
+	for _, p := range j.PagePaths {
+		b, err := r.Images.Download(ctx, p)
+		if err != nil {
+			return nil, fmt.Errorf("download %s: %w", p, err)
+		}
+		pages = append(pages, b)
+	}
+	res, err := r.Extractor.Extract(ctx, pages)
+	if err != nil {
+		return nil, fmt.Errorf("extract: %w", err)
+	}
+	// Model output is untrusted; the phone should never get a broken result.
+	if err := res.Validate(); err != nil {
+		return nil, fmt.Errorf("invalid result: %w", err)
+	}
+	b, err := json.Marshal(res)
+	if err != nil {
+		return nil, fmt.Errorf("encode result: %w", err)
+	}
+	return b, nil
+}
+
+// DeletePages removes a job's photos. Exported for the stale-job sweep.
+func DeletePages(ctx context.Context, images Images, log *slog.Logger, paths []string) {
+	if err := images.Delete(ctx, paths); err != nil {
+		log.Error("could not delete pages", "paths", paths, "err", err)
+	}
+}
+
+// deletePages: a failure is only logged. The result is already stored, and
+// the owner's phone keeps its own copy of the photos.
+func (r *Runner) deletePages(ctx context.Context, log *slog.Logger, j *Job) {
+	DeletePages(ctx, r.Images, log, j.PagePaths)
+}
diff --git a/worker/main.go b/worker/main.go
new file mode 100644
index 0000000..2b42702
--- /dev/null
+++ b/worker/main.go
@@ -0,0 +1,222 @@
+// Command worker reads PO photos into the extraction JSON (build guide
+// section 9). It polls the extraction_jobs table, so it needs no inbound port:
+// run it on a laptop, a small VPS, or the Ubuntu server.
+//
+// Configuration (environment variables, e.g. from an env file; never commit it):
+//
+//	DATABASE_URL          Postgres connection string of the Supabase project
+//	                      (Project Settings > Database > Session pooler).
+//	SUPABASE_URL          https://<project>.supabase.co
+//	SUPABASE_SERVICE_KEY  service_role / secret key. Worker only, never the app.
+//	EXTRACTOR             fake (default), later ollama or cloud
+//	POLL_INTERVAL         how often to look for work when idle (default 3s)
+//	JOB_TIMEOUT           limit for one job (default 3m)
+//	WORKER_ID             name in locked_by (default hostname-pid)
+package main
+
+import (
+	"context"
+	"fmt"
+	"log/slog"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgxpool"
+
+	"listproduk/worker/extractor"
+	"listproduk/worker/job"
+	"listproduk/worker/queue"
+	"listproduk/worker/storage"
+)
+
+const (
+	// A job still 'running' after this long belongs to a worker that died.
+	staleAfter = 15 * time.Minute
+	// Results the phone never fetched are deleted after this long.
+	keepResults = 14 * 24 * time.Hour
+)
+
+type config struct {
+	databaseURL  string
+	supabaseURL  string
+	serviceKey   string
+	extractor    string
+	pollInterval time.Duration
+	jobTimeout   time.Duration
+	workerID     string
+}
+
+func loadConfig() (config, error) {
+	c := config{
+		databaseURL: os.Getenv("DATABASE_URL"),
+		supabaseURL: os.Getenv("SUPABASE_URL"),
+		serviceKey:  os.Getenv("SUPABASE_SERVICE_KEY"),
+		extractor:   os.Getenv("EXTRACTOR"),
+		workerID:    os.Getenv("WORKER_ID"),
+	}
+	var missing []string
+	for _, kv := range [][2]string{
+		{"DATABASE_URL", c.databaseURL},
+		{"SUPABASE_URL", c.supabaseURL},
+		{"SUPABASE_SERVICE_KEY", c.serviceKey},
+	} {
+		if kv[1] == "" {
+			missing = append(missing, kv[0])
+		}
+	}
+	if len(missing) > 0 {
+		return c, fmt.Errorf("missing environment variables: %v", missing)
+	}
+	var err error
+	if c.pollInterval, err = durationEnv("POLL_INTERVAL", 3*time.Second); err != nil {
+		return c, err
+	}
+	if c.jobTimeout, err = durationEnv("JOB_TIMEOUT", 3*time.Minute); err != nil {
+		return c, err
+	}
+	if c.extractor == "" {
+		c.extractor = "fake"
+	}
+	if c.workerID == "" {
+		host, _ := os.Hostname()
+		c.workerID = fmt.Sprintf("%s-%d", host, os.Getpid())
+	}
+	return c, nil
+}
+
+func durationEnv(name string, def time.Duration) (time.Duration, error) {
+	v := os.Getenv(name)
+	if v == "" {
+		return def, nil
+	}
+	d, err := time.ParseDuration(v)
+	if err != nil {
+		return 0, fmt.Errorf("%s: %w", name, err)
+	}
+	return d, nil
+}
+
+func main() {
+	log := slog.New(slog.NewTextHandler(os.Stderr, nil))
+	if err := run(log); err != nil {
+		log.Error("worker stopped", "err", err)
+		os.Exit(1)
+	}
+}
+
+func run(log *slog.Logger) error {
+	cfg, err := loadConfig()
+	if err != nil {
+		return err
+	}
+	ext, err := extractor.New(cfg.extractor)
+	if err != nil {
+		return err
+	}
+
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer stop()
+
+	poolCfg, err := pgxpool.ParseConfig(cfg.databaseURL)
+	if err != nil {
+		return fmt.Errorf("DATABASE_URL: %w", err)
+	}
+	// Simple protocol works through every Supabase pooler mode, including the
+	// transaction pooler, which does not keep prepared statements.
+	poolCfg.ConnConfig.DefaultQueryExecMode = pgx.QueryExecModeSimpleProtocol
+	poolCfg.MaxConns = 2
+	pool, err := pgxpool.NewWithConfig(ctx, poolCfg)
+	if err != nil {
+		return err
+	}
+	defer pool.Close()
+	if err := pool.Ping(ctx); err != nil {
+		return fmt.Errorf("database: %w", err)
+	}
+
+	q := queue.New(pool)
+	images := storage.New(cfg.supabaseURL, cfg.serviceKey, "po-images")
+	runner := &job.Runner{
+		Queue:      q,
+		Images:     images,
+		Extractor:  ext,
+		WorkerID:   cfg.workerID,
+		JobTimeout: cfg.jobTimeout,
+		Log:        log,
+	}
+	log.Info("worker started", "id", cfg.workerID, "extractor", cfg.extractor, "poll", cfg.pollInterval)
+
+	maintain := func() {
+		stale, err := q.RecoverStale(ctx, staleAfter)
+		if err != nil {
+			log.Error("recover stale jobs", "err", err)
+		}
+		for _, s := range stale {
+			log.Warn("took back stale job", "job", s.ID, "failed", s.Failed)
+			if s.Failed {
+				job.DeletePages(ctx, images, log, s.PagePaths)
+			}
+		}
+	}
+	cleanup := func() {
+		n, err := q.Cleanup(ctx, keepResults)
+		if err != nil {
+			log.Error("cleanup", "err", err)
+		} else if n > 0 {
+			log.Info("cleanup", "deleted_jobs", n)
+		}
+	}
+	maintain()
+	cleanup()
+	lastMaintain, lastCleanup := time.Now(), time.Now()
+
+	backoff := cfg.pollInterval
+	for {
+		if time.Since(lastMaintain) > time.Minute {
+			maintain()
+			lastMaintain = time.Now()
+		}
+		if time.Since(lastCleanup) > 24*time.Hour {
+			cleanup()
+			lastCleanup = time.Now()
+		}
+		worked, err := runner.ProcessOne(ctx)
+		if ctx.Err() != nil {
+			log.Info("worker stopping")
+			return nil
+		}
+		switch {
+		case err != nil:
+			// Database trouble: wait longer each time, up to a minute.
+			backoff = min(backoff*2, time.Minute)
+			log.Error("queue", "err", err, "retry_in", backoff)
+			if !sleep(ctx, backoff) {
+				log.Info("worker stopping")
+				return nil
+			}
+		case worked:
+			backoff = cfg.pollInterval // more work may be waiting: no pause
+		default:
+			backoff = cfg.pollInterval
+			if !sleep(ctx, cfg.pollInterval) {
+				log.Info("worker stopping")
+				return nil
+			}
+		}
+	}
+}
+
+// sleep waits d, or returns false at once when ctx is cancelled.
+func sleep(ctx context.Context, d time.Duration) bool {
+	t := time.NewTimer(d)
+	defer t.Stop()
+	select {
+	case <-ctx.Done():
+		return false
+	case <-t.C:
+		return true
+	}
+}
diff --git a/worker/queue/queue.go b/worker/queue/queue.go
new file mode 100644
index 0000000..be559ba
--- /dev/null
+++ b/worker/queue/queue.go
@@ -0,0 +1,157 @@
+// Package queue is the extraction_jobs table as a work queue.
+//
+// Jobs are claimed with FOR UPDATE SKIP LOCKED inside a single UPDATE, so
+// several workers can run at once and each job goes to exactly one of them.
+// The worker connects as the database owner (service role), which bypasses
+// row level security; the phone only ever reads its own jobs.
+package queue
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgconn"
+
+	"listproduk/worker/job"
+)
+
+// DB is what the queue needs from a connection or pool (*pgxpool.Pool fits).
+type DB interface {
+	Exec(ctx context.Context, sql string, args ...any) (pgconn.CommandTag, error)
+	QueryRow(ctx context.Context, sql string, args ...any) pgx.Row
+	Query(ctx context.Context, sql string, args ...any) (pgx.Rows, error)
+}
+
+type Queue struct {
+	db DB
+}
+
+func New(db DB) *Queue { return &Queue{db: db} }
+
+var _ job.Queue = (*Queue)(nil)
+
+// Claim takes the oldest pending job and counts the attempt. Counting at
+// claim time means a worker that crashes mid-job still uses up a try.
+func (q *Queue) Claim(ctx context.Context, workerID string) (*job.Job, error) {
+	var j job.Job
+	err := q.db.QueryRow(ctx, `
+		UPDATE extraction_jobs j
+		   SET status = 'running', locked_by = $1, locked_at = now(),
+		       attempts = j.attempts + 1
+		 WHERE j.id = (SELECT id FROM extraction_jobs
+		                WHERE status = 'pending'
+		                ORDER BY created_at, id
+		                LIMIT 1
+		                FOR UPDATE SKIP LOCKED)
+		RETURNING j.id::text, j.store_id::text, j.page_paths, j.attempts`,
+		workerID,
+	).Scan(&j.ID, &j.StoreID, &j.PagePaths, &j.Attempts)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	return &j, nil
+}
+
+// Complete stores the result for the owner's phone to fetch.
+func (q *Queue) Complete(ctx context.Context, id string, result []byte) error {
+	// The result goes as text and is cast in SQL, so it works over both the
+	// extended and the simple protocol (Supabase's transaction pooler).
+	_, err := q.db.Exec(ctx, `
+		UPDATE extraction_jobs
+		   SET status = 'done', result = $2::jsonb, finished_at = now(),
+		       last_error = NULL, locked_by = NULL, locked_at = NULL
+		 WHERE id = $1::uuid AND status = 'running'`,
+		id, string(result),
+	)
+	return err
+}
+
+// Fail records msg. With retry the job goes back to pending; otherwise it is
+// failed for good and the phone shows it as "Gagal".
+func (q *Queue) Fail(ctx context.Context, id string, msg string, retry bool) error {
+	_, err := q.db.Exec(ctx, `
+		UPDATE extraction_jobs
+		   SET status = (CASE WHEN $3::boolean THEN 'pending' ELSE 'failed' END)::job_status,
+		       last_error = $2,
+		       finished_at = CASE WHEN $3::boolean THEN NULL ELSE now() END,
+		       locked_by = NULL, locked_at = NULL
+		 WHERE id = $1::uuid AND status = 'running'`,
+		id, truncate(msg, 1000), retry,
+	)
+	return err
+}
+
+// Release puts a running job back to pending without counting the attempt.
+func (q *Queue) Release(ctx context.Context, id string) error {
+	_, err := q.db.Exec(ctx, `
+		UPDATE extraction_jobs
+		   SET status = 'pending', attempts = greatest(attempts - 1, 0),
+		       locked_by = NULL, locked_at = NULL
+		 WHERE id = $1::uuid AND status = 'running'`,
+		id,
+	)
+	return err
+}
+
+// Stale is a job taken back from a worker that stopped without finishing.
+type Stale struct {
+	ID        string
+	PagePaths []string
+	Failed    bool // out of attempts: its pages should be deleted
+}
+
+// RecoverStale handles jobs left 'running' for longer than olderThan (the
+// worker died or lost its connection): back to pending, or failed when out
+// of attempts.
+func (q *Queue) RecoverStale(ctx context.Context, olderThan time.Duration) ([]Stale, error) {
+	rows, err := q.db.Query(ctx, `
+		UPDATE extraction_jobs
+		   SET status = (CASE WHEN attempts >= $2::int THEN 'failed' ELSE 'pending' END)::job_status,
+		       last_error = 'worker stopped while reading this job',
+		       finished_at = CASE WHEN attempts >= $2::int THEN now() END,
+		       locked_by = NULL, locked_at = NULL
+		 WHERE status = 'running'
+		   AND locked_at < now() - make_interval(secs => $1::float8)
+		RETURNING id::text, page_paths, status = 'failed'`,
+		olderThan.Seconds(), job.MaxAttempts,
+	)
+	if err != nil {
+		return nil, err
+	}
+	return pgx.CollectRows(rows, func(r pgx.CollectableRow) (Stale, error) {
+		var s Stale
+		err := r.Scan(&s.ID, &s.PagePaths, &s.Failed)
+		return s, err
+	})
+}
+
+// Cleanup deletes jobs whose result the phone has fetched, and any job that
+// finished more than keepFor ago. Their pages are already gone. Returns the
+// number of deleted jobs.
+func (q *Queue) Cleanup(ctx context.Context, keepFor time.Duration) (int64, error) {
+	tag, err := q.db.Exec(ctx, `
+		DELETE FROM extraction_jobs
+		 WHERE fetched_at IS NOT NULL
+		    OR finished_at < now() - make_interval(secs => $1::float8)`,
+		keepFor.Seconds(),
+	)
+	if err != nil {
+		return 0, err
+	}
+	return tag.RowsAffected(), nil
+}
+
+// truncate cuts s to at most n bytes without splitting a character
+// (Postgres rejects invalid UTF-8).
+func truncate(s string, n int) string {
+	if len(s) <= n {
+		return s
+	}
+	return strings.ToValidUTF8(s[:n], "")
+}
diff --git a/worker/queue/queue_test.go b/worker/queue/queue_test.go
new file mode 100644
index 0000000..f5fadc9
--- /dev/null
+++ b/worker/queue/queue_test.go
@@ -0,0 +1,469 @@
+package queue_test
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/jackc/pgx/v5/pgxpool"
+
+	"listproduk/worker/extractor"
+	"listproduk/worker/internal/testdb"
+	"listproduk/worker/job"
+	"listproduk/worker/queue"
+)
+
+// submit queues a job the way the phone does (submit_extraction inserts it).
+func submit(t *testing.T, pool *pgxpool.Pool, store string, paths ...string) string {
+	t.Helper()
+	var id string
+	err := pool.QueryRow(context.Background(), `
+		insert into extraction_jobs (store_id, page_paths)
+		values ($1::uuid, $2::text[]) returning id::text`, store, paths).Scan(&id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return id
+}
+
+type row struct {
+	status, lastError, result string
+	attempts                  int
+	finished, locked          bool
+}
+
+func get(t *testing.T, pool *pgxpool.Pool, id string) row {
+	t.Helper()
+	var r row
+	err := pool.QueryRow(context.Background(), `
+		select status::text, coalesce(last_error, ''), coalesce(result::text, ''),
+		       attempts, finished_at is not null, locked_by is not null
+		  from extraction_jobs where id = $1::uuid`, id).
+		Scan(&r.status, &r.lastError, &r.result, &r.attempts, &r.finished, &r.locked)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return r
+}
+
+// memImages is the bucket in memory.
+type memImages struct {
+	mu      sync.Mutex
+	objects map[string][]byte
+	deleted []string
+}
+
+func newImages(paths ...string) *memImages {
+	m := &memImages{objects: map[string][]byte{}}
+	for _, p := range paths {
+		m.objects[p] = []byte("jpeg " + p)
+	}
+	return m
+}
+
+func (m *memImages) Download(_ context.Context, p string) ([]byte, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	b, ok := m.objects[p]
+	if !ok {
+		return nil, fmt.Errorf("%s: %w", p, job.ErrPermanent)
+	}
+	return b, nil
+}
+
+func (m *memImages) Delete(_ context.Context, paths []string) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	for _, p := range paths {
+		delete(m.objects, p)
+		m.deleted = append(m.deleted, p)
+	}
+	return nil
+}
+
+type failingExtractor struct{ err error }
+
+func (f failingExtractor) Extract(context.Context, [][]byte) (extractor.Result, error) {
+	return extractor.Result{}, f.err
+}
+
+func runner(pool *pgxpool.Pool, images job.Images, ext extractor.Extractor) *job.Runner {
+	return &job.Runner{
+		Queue:     queue.New(pool),
+		Images:    images,
+		Extractor: ext,
+		WorkerID:  "test-worker",
+	}
+}
+
+func TestClaimTakesOldestPendingAndCountsTheAttempt(t *testing.T) {
+	pool := testdb.Open(t)
+	store := testdb.NewStore(t, pool)
+	first := submit(t, pool, store, store+"/po1/1.jpg", store+"/po1/2.jpg")
+	submit(t, pool, store, store+"/po2/1.jpg")
+	q := queue.New(pool)
+	ctx := context.Background()
+
+	j, err := q.Claim(ctx, "w1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if j.ID != first || j.StoreID != store || j.Attempts != 1 {
+		t.Fatalf("claimed %+v, want first job with attempt 1", j)
+	}
+	if len(j.PagePaths) != 2 || j.PagePaths[1] != store+"/po1/2.jpg" {
+		t.Fatalf("pages out of order: %v", j.PagePaths)
+	}
+	if r := get(t, pool, first); r.status != "running" || !r.locked {
+		t.Fatalf("after claim: %+v", r)
+	}
+}
+
+func TestClaimReturnsNilWhenNothingIsPending(t *testing.T) {
+	pool := testdb.Open(t)
+	j, err := queue.New(pool).Claim(context.Background(), "w1")
+	if err != nil || j != nil {
+		t.Fatalf("got %v, %v; want nil, nil", j, err)
+	}
+}
+
+func TestConcurrentWorkersNeverGetTheSameJob(t *testing.T) {
+	pool := testdb.Open(t)
+	store := testdb.NewStore(t, pool)
+	const jobs = 20
+	for i := 0; i < jobs; i++ {
+		submit(t, pool, store, fmt.Sprintf("%s/po%d/1.jpg", store, i))
+	}
+	q := queue.New(pool)
+
+	var mu sync.Mutex
+	seen := map[string]string{}
+	var wg sync.WaitGroup
+	for w := 0; w < 5; w++ {
+		wg.Add(1)
+		go func(worker string) {
+			defer wg.Done()
+			for {
+				j, err := q.Claim(context.Background(), worker)
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				if j == nil {
+					return
+				}
+				mu.Lock()
+				if other, dup := seen[j.ID]; dup {
+					t.Errorf("job %s claimed by %s and %s", j.ID, other, worker)
+				}
+				seen[j.ID] = worker
+				mu.Unlock()
+			}
+		}(fmt.Sprintf("w%d", w))
+	}
+	wg.Wait()
+	if len(seen) != jobs {
+		t.Fatalf("claimed %d jobs, want %d", len(seen), jobs)
+	}
+}
+
+func TestRunnerDoneStoresResultAndDeletesPages(t *testing.T) {
+	pool := testdb.Open(t)
+	store := testdb.NewStore(t, pool)
+	paths := []string{store + "/po1/1.jpg", store + "/po1/2.jpg"}
+	id := submit(t, pool, store, paths...)
+	images := newImages(paths...)
+
+	worked, err := runner(pool, images, extractor.NewFake()).ProcessOne(context.Background())
+	if err != nil || !worked {
+		t.Fatalf("worked=%v err=%v", worked, err)
+	}
+	r := get(t, pool, id)
+	if r.status != "done" || !r.finished || r.locked {
+		t.Fatalf("after done: %+v", r)
+	}
+	var res extractor.Result
+	if err := json.Unmarshal([]byte(r.result), &res); err != nil {
+		t.Fatal(err)
+	}
+	if *res.Supplier.Name != "CV Maju Elektrik" || len(res.Lines) == 0 {
+		t.Fatalf("unexpected result: %+v", res)
+	}
+	if len(images.objects) != 0 {
+		t.Fatalf("pages left in the bucket: %v", images.objects)
+	}
+}
+
+func TestRunnerRetriesThenFailsAfterThreeAttempts(t *testing.T) {
+	pool := testdb.Open(t)
+	store := testdb.NewStore(t, pool)
+	path := store + "/po1/1.jpg"
+	id := submit(t, pool, store, path)
+	images := newImages(path)
+	r := runner(pool, images, failingExtractor{errors.New("model busy")})
+	ctx := context.Background()
+
+	for attempt := 1; attempt <= 2; attempt++ {
+		if _, err := r.ProcessOne(ctx); err != nil {
+			t.Fatal(err)
+		}
+		got := get(t, pool, id)
+		if got.status != "pending" || got.attempts != attempt || got.lastError == "" {
+			t.Fatalf("after attempt %d: %+v", attempt, got)
+		}
+		if len(images.deleted) != 0 {
+			t.Fatal("pages deleted before the last attempt")
+		}
+	}
+	if _, err := r.ProcessOne(ctx); err != nil {
+		t.Fatal(err)
+	}
+	got := get(t, pool, id)
+	if got.status != "failed" || got.attempts != 3 || !got.finished {
+		t.Fatalf("after attempt 3: %+v", got)
+	}
+	if len(images.deleted) != 1 {
+		t.Fatalf("pages should be deleted when failed for good: %v", images.deleted)
+	}
+}
+
+func TestRunnerFailsAtOnceWhenAPageIsMissing(t *testing.T) {
+	pool := testdb.Open(t)
+	store := testdb.NewStore(t, pool)
+	id := submit(t, pool, store, store+"/po1/1.jpg", store+"/po1/2.jpg")
+	images := newImages(store + "/po1/1.jpg") // page 2 never uploaded
+
+	if _, err := runner(pool, images, extractor.NewFake()).ProcessOne(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if got := get(t, pool, id); got.status != "failed" || got.attempts != 1 {
+		t.Fatalf("missing page: %+v", got)
+	}
+}
+
+// invalidExtractor returns output that breaks the contract.
+type invalidExtractor struct{}
+
+func (invalidExtractor) Extract(context.Context, [][]byte) (extractor.Result, error) {
+	bad := int64(-5)
+	return extractor.Result{Lines: []extractor.Line{{Name: "X", UnitPrice: &bad}}}, nil
+}
+
+func TestRunnerNeverStoresAnInvalidResult(t *testing.T) {
+	pool := testdb.Open(t)
+	store := testdb.NewStore(t, pool)
+	path := store + "/po1/1.jpg"
+	id := submit(t, pool, store, path)
+
+	if _, err := runner(pool, newImages(path), invalidExtractor{}).ProcessOne(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	got := get(t, pool, id)
+	if got.status != "pending" || got.result != "" {
+		t.Fatalf("invalid result must not be stored: %+v", got)
+	}
+}
+
+// blockingExtractor waits until the context is cancelled (a shutdown).
+type blockingExtractor struct{ started chan struct{} }
+
+func (b blockingExtractor) Extract(ctx context.Context, _ [][]byte) (extractor.Result, error) {
+	close(b.started)
+	<-ctx.Done()
+	return extractor.Result{}, ctx.Err()
+}
+
+func TestShutdownPutsTheJobBackWithoutUsingAnAttempt(t *testing.T) {
+	pool := testdb.Open(t)
+	store := testdb.NewStore(t, pool)
+	path := store + "/po1/1.jpg"
+	id := submit(t, pool, store, path)
+	images := newImages(path)
+	ext := blockingExtractor{started: make(chan struct{})}
+
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error)
+	go func() {
+		_, err := runner(pool, images, ext).ProcessOne(ctx)
+		done <- err
+	}()
+	<-ext.started
+	cancel()
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	got := get(t, pool, id)
+	if got.status != "pending" || got.attempts != 0 || got.locked {
+		t.Fatalf("after shutdown: %+v", got)
+	}
+	if len(images.deleted) != 0 {
+		t.Fatal("pages must stay for the next try")
+	}
+}
+
+func TestRecoverStale(t *testing.T) {
+	pool := testdb.Open(t)
+	store := testdb.NewStore(t, pool)
+	ctx := context.Background()
+	retry := submit(t, pool, store, store+"/a/1.jpg")
+	outOfTries := submit(t, pool, store, store+"/b/1.jpg")
+	fresh := submit(t, pool, store, store+"/c/1.jpg")
+	_, err := pool.Exec(ctx, `
+		update extraction_jobs set status = 'running', locked_by = 'dead',
+		       locked_at = now() - interval '1 hour',
+		       attempts = case when id = $2::uuid then 3 else 1 end
+		 where id in ($1::uuid, $2::uuid);
+		`, retry, outOfTries)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := pool.Exec(ctx, `update extraction_jobs set status = 'running',
+		locked_at = now() where id = $1::uuid`, fresh); err != nil {
+		t.Fatal(err)
+	}
+
+	stale, err := queue.New(pool).RecoverStale(ctx, 15*time.Minute)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(stale) != 2 {
+		t.Fatalf("recovered %d jobs, want 2: %+v", len(stale), stale)
+	}
+	if got := get(t, pool, retry); got.status != "pending" {
+		t.Fatalf("retry job: %+v", got)
+	}
+	if got := get(t, pool, outOfTries); got.status != "failed" || !got.finished {
+		t.Fatalf("job out of tries: %+v", got)
+	}
+	if got := get(t, pool, fresh); got.status != "running" {
+		t.Fatalf("a job still being worked on was taken: %+v", got)
+	}
+	for _, s := range stale {
+		if s.ID == outOfTries && !s.Failed {
+			t.Fatal("out-of-tries job should be reported failed (pages to delete)")
+		}
+	}
+}
+
+func TestCleanup(t *testing.T) {
+	pool := testdb.Open(t)
+	store := testdb.NewStore(t, pool)
+	ctx := context.Background()
+	fetched := submit(t, pool, store, "x")
+	old := submit(t, pool, store, "y")
+	recent := submit(t, pool, store, "z")
+	pending := submit(t, pool, store, "w")
+	_, err := pool.Exec(ctx, `
+		update extraction_jobs set status = 'done', finished_at = now(), fetched_at = now()
+		 where id = $1::uuid;`, fetched)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = pool.Exec(ctx, `
+		update extraction_jobs set status = 'done', finished_at = now() - interval '15 days'
+		 where id = $1::uuid;`, old)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = pool.Exec(ctx, `
+		update extraction_jobs set status = 'done', finished_at = now() - interval '2 days'
+		 where id = $1::uuid;`, recent)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	n, err := queue.New(pool).Cleanup(ctx, 14*24*time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if n != 2 {
+		t.Fatalf("deleted %d, want 2", n)
+	}
+	left := map[string]bool{}
+	rows, err := pool.Query(ctx, `select id::text from extraction_jobs`)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for rows.Next() {
+		var id string
+		if err := rows.Scan(&id); err != nil {
+			t.Fatal(err)
+		}
+		left[id] = true
+	}
+	if len(left) != 2 || !left[recent] || !left[pending] {
+		t.Fatalf("left %v, want only the recent and the pending job", left)
+	}
+}
+
+// The whole round trip through the functions the phone calls, as the owner:
+// submit_extraction, the worker, reading the result, mark_extraction_fetched,
+// and the cleanup that then removes the job.
+func TestPhoneAndWorkerContract(t *testing.T) {
+	pool := testdb.Open(t)
+	ctx := context.Background()
+	conn, err := pool.Acquire(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Release()
+
+	// Sign in as the owner: auth.uid() reads this setting.
+	owner := "11111111-1111-4111-8111-111111111111"
+	if _, err := conn.Exec(ctx, `insert into auth.users (id) values ($1::uuid)
+		on conflict do nothing`, owner); err != nil {
+		t.Skip("not a plain Postgres with stub auth.users; skipping:", err)
+	}
+	if _, err := conn.Exec(ctx, `select set_config('request.jwt.claim.sub', $1, false)`, owner); err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Exec(ctx, `select set_config('request.jwt.claim.sub', '', false)`)
+
+	var store, jobID string
+	if err := conn.QueryRow(ctx, `select create_store('Toko Uji')::text`).Scan(&store); err != nil {
+		t.Fatal(err)
+	}
+	paths := []string{store + "/po1/1.jpg"}
+	if err := conn.QueryRow(ctx, `select submit_extraction($1::uuid, $2::text[])::text`,
+		store, paths).Scan(&jobID); err != nil {
+		t.Fatal(err)
+	}
+
+	// A job without pages is refused by the server.
+	if _, err := conn.Exec(ctx, `select submit_extraction($1::uuid, '{}'::text[])`, store); err == nil {
+		t.Fatal("submit_extraction accepted a job without pages")
+	}
+
+	if _, err := runner(pool, newImages(paths...), extractor.NewFake()).ProcessOne(ctx); err != nil {
+		t.Fatal(err)
+	}
+
+	var status, result string
+	if err := conn.QueryRow(ctx, `select status::text, result::text from extraction_jobs
+		where id = $1::uuid`, jobID).Scan(&status, &result); err != nil {
+		t.Fatal(err)
+	}
+	if status != "done" || result == "" {
+		t.Fatalf("phone sees %s / %q", status, result)
+	}
+
+	if _, err := conn.Exec(ctx, `select mark_extraction_fetched($1::uuid)`, jobID); err != nil {
+		t.Fatal(err)
+	}
+	var cleared bool
+	if err := conn.QueryRow(ctx, `select result is null and fetched_at is not null
+		from extraction_jobs where id = $1::uuid`, jobID).Scan(&cleared); err != nil {
+		t.Fatal(err)
+	}
+	if !cleared {
+		t.Fatal("mark_extraction_fetched should clear the result")
+	}
+
+	if n, err := queue.New(pool).Cleanup(ctx, 14*24*time.Hour); err != nil || n != 1 {
+		t.Fatalf("cleanup deleted %d (%v), want the fetched job", n, err)
+	}
+}
diff --git a/worker/storage/storage.go b/worker/storage/storage.go
new file mode 100644
index 0000000..962c1ec
--- /dev/null
+++ b/worker/storage/storage.go
@@ -0,0 +1,126 @@
+// Package storage reads and deletes PO photos in Supabase Storage with the
+// service key. Only the worker has that key; it never goes into the app.
+package storage
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+
+	"listproduk/worker/job"
+)
+
+// Client talks to one bucket.
+type Client struct {
+	BaseURL string // https://<project>.supabase.co
+	Key     string // legacy service_role key, or a new sb_secret_... key
+	Bucket  string // "po-images"
+	HTTP    *http.Client
+}
+
+// New returns a client for bucket.
+func New(baseURL, key, bucket string) *Client {
+	return &Client{
+		BaseURL: strings.TrimRight(baseURL, "/"),
+		Key:     key,
+		Bucket:  bucket,
+		HTTP:    &http.Client{Timeout: 60 * time.Second},
+	}
+}
+
+func (c *Client) objectURL(path string) string {
+	parts := strings.Split(path, "/")
+	for i, p := range parts {
+		parts[i] = url.PathEscape(p)
+	}
+	return fmt.Sprintf("%s/storage/v1/object/%s/%s",
+		c.BaseURL, url.PathEscape(c.Bucket), strings.Join(parts, "/"))
+}
+
+func (c *Client) authorize(req *http.Request) {
+	req.Header.Set("apikey", c.Key)
+	// Legacy service_role keys are JWTs and also go in Authorization. The new
+	// sb_secret_ keys are not JWTs; the gateway only wants them in apikey.
+	if strings.HasPrefix(c.Key, "eyJ") {
+		req.Header.Set("Authorization", "Bearer "+c.Key)
+	}
+}
+
+// Download returns one object. A missing object wraps job.ErrPermanent:
+// retrying will not bring it back.
+func (c *Client) Download(ctx context.Context, path string) ([]byte, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, c.objectURL(path), nil)
+	if err != nil {
+		return nil, err
+	}
+	c.authorize(req)
+	resp, err := c.HTTP.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(resp.Body, 50<<20))
+	if err != nil {
+		return nil, err
+	}
+	if resp.StatusCode == http.StatusOK {
+		return body, nil
+	}
+	if notFound(resp.StatusCode, body) {
+		return nil, fmt.Errorf("object %s not found: %w", path, job.ErrPermanent)
+	}
+	return nil, fmt.Errorf("storage download %s: %s: %s", path, resp.Status, snippet(body))
+}
+
+// Delete removes objects. Objects that are already gone are not an error.
+func (c *Client) Delete(ctx context.Context, paths []string) error {
+	if len(paths) == 0 {
+		return nil
+	}
+	payload, err := json.Marshal(map[string][]string{"prefixes": paths})
+	if err != nil {
+		return err
+	}
+	u := fmt.Sprintf("%s/storage/v1/object/%s", c.BaseURL, url.PathEscape(c.Bucket))
+	req, err := http.NewRequestWithContext(ctx, http.MethodDelete, u, bytes.NewReader(payload))
+	if err != nil {
+		return err
+	}
+	c.authorize(req)
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := c.HTTP.Do(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	body, _ := io.ReadAll(io.LimitReader(resp.Body, 1<<16))
+	if resp.StatusCode >= 300 {
+		return fmt.Errorf("storage delete: %s: %s", resp.Status, snippet(body))
+	}
+	return nil
+}
+
+// Supabase Storage answers a missing object with 404, or with 400 and
+// "not_found" in the body, depending on the version.
+func notFound(status int, body []byte) bool {
+	if status == http.StatusNotFound {
+		return true
+	}
+	b := strings.ToLower(string(body))
+	return status == http.StatusBadRequest &&
+		(strings.Contains(b, "not_found") || strings.Contains(b, "not found"))
+}
+
+func snippet(b []byte) string {
+	s := strings.TrimSpace(string(b))
+	if len(s) > 200 {
+		s = s[:200] + "…"
+	}
+	return s
+}
