+                          ),
+                        ),
+                      ),
+                    ),
+                    if (badge != null) Positioned(left: 8, top: 8, child: badge!),
+                  ],
+                ),
+              ),
+              Padding(
+                padding: const EdgeInsets.fromLTRB(4, 12, 4, 10),
