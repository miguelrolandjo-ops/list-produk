diff --git a/app/lib/core/server_api.dart b/app/lib/core/server_api.dart
new file mode 100644
index 0000000..3d005fc
--- /dev/null
+++ b/app/lib/core/server_api.dart
@@ -0,0 +1,192 @@
+/// Everything the app asks of the server, behind one interface so services can
+/// be tested with a fake and the Supabase client stays in one file
+/// (`supabase_server_api.dart`).
+///
+/// The server only knows the employee catalog, store access, and (later) the
+/// PO queue. Supplier data never goes through this interface.
+library;
+
+class ServerUser {
+  const ServerUser({required this.id, this.email, required this.isAnonymous});
+
+  final String id;
+  final String? email;
+
+  /// Employees sign in anonymously; the owner signs in with email.
+  final bool isAnonymous;
+}
+
+enum ServerErrorKind {
+  /// No connection, or the server didn't answer.
+  offline,
+
+  /// The server refused: not a member, access revoked, not the owner.
+  notAllowed,
+
+  /// accept_invite: the code doesn't exist, expired, or was cancelled.
+  inviteInvalid,
+  invalidLogin,
+  emailNotConfirmed,
+  emailTaken,
+  weakPassword,
+
+  /// Anonymous sign-ins are switched off in the Supabase dashboard.
+  anonymousDisabled,
+
+  /// The app was built without SUPABASE_URL / SUPABASE_ANON_KEY.
+  notConfigured,
+  other,
+}
+
+class ServerException implements Exception {
+  const ServerException(this.kind, [this.detail]);
+
+  final ServerErrorKind kind;
+
+  /// The server's own message, for logs. Not shown to the user as is.
+  final String? detail;
+
+  /// What to tell the user, in the app's language.
+  String get message => switch (kind) {
+    ServerErrorKind.offline =>
+      'Tidak ada koneksi ke server. Periksa internet lalu coba lagi.',
+    ServerErrorKind.notAllowed => 'Akses ditolak oleh server.',
+    ServerErrorKind.inviteInvalid =>
+      'Kode tidak berlaku. Mungkin salah ketik, sudah dibatalkan, atau lewat 7 hari.',
+    ServerErrorKind.invalidLogin => 'Email atau kata sandi salah.',
+    ServerErrorKind.emailNotConfirmed =>
+      'Email belum dikonfirmasi. Buka tautan di email dari Supabase, lalu masuk lagi.',
+    ServerErrorKind.emailTaken => 'Email ini sudah terdaftar. Pilih Masuk.',
+    ServerErrorKind.weakPassword =>
+      'Kata sandi terlalu lemah. Pakai minimal 8 karakter.',
+    ServerErrorKind.anonymousDisabled =>
+      'Server belum mengizinkan karyawan bergabung. Pemilik perlu '
+          'menyalakan "Anonymous sign-ins" di Supabase.',
+    ServerErrorKind.notConfigured =>
+      'Server belum diatur di aplikasi ini.',
+    ServerErrorKind.other => 'Terjadi kesalahan di server. Coba lagi nanti.',
+  };
+
+  @override
+  String toString() => 'ServerException($kind${detail == null ? '' : ': $detail'})';
+}
+
+/// One row of employee_catalog(). [updatedAt] is the server's timestamp exactly
+/// as received: it goes back to the server as the next sync cursor, so it is
+/// never parsed or reformatted.
+class CatalogRow {
+  const CatalogRow({
+    required this.id,
+    required this.name,
+    this.model,
+    this.category,
+    this.unit = 'pcs',
+    this.photoPath,
+    this.retailPrice,
+    this.isDeleted = false,
+    required this.updatedAt,
+  });
+
+  factory CatalogRow.fromJson(Map<String, dynamic> j) => CatalogRow(
+    id: j['id'] as String,
+    name: j['name'] as String,
+    model: j['model'] as String?,
+    category: j['category'] as String?,
+    unit: (j['unit'] as String?) ?? 'pcs',
+    photoPath: j['photo_path'] as String?,
+    retailPrice: (j['retail_price'] as num?)?.toInt(),
+    isDeleted: (j['is_deleted'] as bool?) ?? false,
+    updatedAt: j['updated_at'] as String,
+  );
+
+  final String id;
+  final String name;
+  final String? model;
+  final String? category;
+  final String unit;
+  final String? photoPath;
+  final int? retailPrice;
+  final bool isDeleted;
+  final String updatedAt;
+}
+
+class StoreMember {
+  const StoreMember({
+    required this.userId,
+    this.displayName,
+    this.deviceLabel,
+    required this.joinedAt,
+    this.lastSeenAt,
+    this.revokedAt,
+  });
+
+  final String userId;
+  final String? displayName;
+  final String? deviceLabel;
+  final DateTime joinedAt;
+  final DateTime? lastSeenAt;
+  final DateTime? revokedAt;
+
+  bool get isActive => revokedAt == null;
+}
+
+class StoreInvite {
+  const StoreInvite({
+    required this.id,
+    required this.code,
+    required this.createdAt,
+    required this.expiresAt,
+  });
+
+  final String id;
+  final String code;
+  final DateTime createdAt;
+  final DateTime expiresAt;
+}
+
+abstract class ServerApi {
+  ServerUser? get currentUser;
+
+  /// Emits whenever someone signs in or out (not the current value on listen).
+  Stream<ServerUser?> get userChanges;
+
+  /// Owner sign-up. Returns false when the project requires email
+  /// confirmation first (no session yet).
+  Future<bool> signUp(String email, String password);
+  Future<void> signIn(String email, String password);
+  Future<void> signInAnonymously();
+  Future<void> signOut();
+
+  /// create_store(): the store plus the owner's membership. Returns its id.
+  Future<String> createStore(String name);
+
+  /// The store's name, or null if this user can't see it.
+  Future<String?> storeName(String storeId);
+
+  /// Whether the signed-in user is the (not revoked) owner of [storeId].
+  Future<bool> isOwnerOf(String storeId);
+
+  /// publish_catalog(). [items] hold only the whitelisted employee fields.
+  Future<int> publishCatalog(String storeId, List<Map<String, Object?>> items);
+
+  /// employee_catalog(): rows changed after [since], oldest first.
+  Future<List<CatalogRow>> employeeCatalog(String storeId, {String? since});
+
+  /// create_invite(): an 8-character code, valid 7 days.
+  Future<String> createInvite(String storeId);
+
+  /// accept_invite(): joins the store as an employee. Returns the store id.
+  Future<String> acceptInvite(
+    String code, {
+    required String name,
+    required String device,
+  });
+
+  /// Employees of the store, revoked ones included (newest first).
+  Future<List<StoreMember>> members(String storeId);
+  Future<void> revokeMember(String storeId, String userId);
+
+  /// Invite codes that can still be used.
+  Future<List<StoreInvite>> activeInvites(String storeId);
+  Future<void> revokeInvite(String inviteId);
+}
diff --git a/app/lib/core/server_config.dart b/app/lib/core/server_config.dart
new file mode 100644
index 0000000..72733ba
--- /dev/null
+++ b/app/lib/core/server_config.dart
@@ -0,0 +1,16 @@
+/// Where the Supabase project lives. Both values come from the build, never
+/// from the code: `flutter run --dart-define-from-file=config.json` (see
+/// `config.example.json`).
+///
+/// Only the anon (publishable) key may ever be passed here. The service role
+/// (secret) key belongs to the Go worker and must never be in the app.
+class ServerConfig {
+  const ServerConfig._();
+
+  static const url = String.fromEnvironment('SUPABASE_URL');
+  static const anonKey = String.fromEnvironment('SUPABASE_ANON_KEY');
+
+  /// Without both values the app runs fully offline: the owner works alone and
+  /// the online screens say the server isn't set up.
+  static bool get isConfigured => url.isNotEmpty && anonKey.isNotEmpty;
+}
diff --git a/app/lib/core/server_providers.dart b/app/lib/core/server_providers.dart
new file mode 100644
index 0000000..60cdfa9
--- /dev/null
+++ b/app/lib/core/server_providers.dart
@@ -0,0 +1,142 @@
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:supabase_flutter/supabase_flutter.dart';
+
+import '../catalog/employee_catalog_repository.dart';
+import '../catalog/employee_session.dart';
+import '../catalog/employee_sync_service.dart';
+import '../catalog/join_service.dart';
+import '../data/employee_database.dart';
+import '../publish/auto_publisher.dart';
+import '../publish/publish_service.dart';
+import '../team/owner_account_service.dart';
+import 'app_mode.dart';
+import 'providers.dart';
+import 'server_api.dart';
+import 'server_config.dart';
+import 'supabase_server_api.dart';
+
+/// The server, or null when the app was built without server settings (and in
+/// tests). Everything online checks for null and stays quiet offline.
+final serverApiProvider = Provider<ServerApi?>(
+  (ref) => ServerConfig.isConfigured
+      ? SupabaseServerApi(Supabase.instance.client)
+      : null,
+);
+
+/// Who is signed in, updated on sign-in and sign-out.
+final serverUserProvider = StreamProvider<ServerUser?>((ref) async* {
+  final api = ref.watch(serverApiProvider);
+  if (api == null) {
+    yield null;
+    return;
+  }
+  yield api.currentUser;
+  yield* api.userChanges;
+});
+
+// ---------------------------------------------------------------- owner side
+
+final publishServiceProvider = Provider<PublishService>(
+  (ref) => PublishService(
+    ref.watch(ownerDbProvider),
+    ref.watch(serverApiProvider),
+  ),
+);
+
+final ownerAccountServiceProvider = Provider<OwnerAccountService>(
+  (ref) => OwnerAccountService(
+    ref.watch(ownerDbProvider),
+    ref.watch(serverApiProvider),
+  ),
+);
+
+final teamServiceProvider = Provider<TeamService>(
+  (ref) => TeamService(
+    ref.watch(ownerAccountServiceProvider),
+    ref.watch(serverApiProvider),
+  ),
+);
+
+/// Account and store status for the account screen and the settings menu.
+/// Re-checked on sign-in/out and when the linked store changes.
+final ownerLinkProvider = FutureProvider<OwnerLink>((ref) async {
+  ref.watch(serverUserProvider);
+  ref.watch(ownerStoreIdProvider);
+  return ref.watch(ownerAccountServiceProvider).check();
+});
+
+final ownerStoreIdProvider = StreamProvider<String?>((ref) {
+  final db = ref.watch(ownerDbProvider);
+  return db
+      .customSelect(
+        'SELECT store_id FROM settings WHERE id = 1',
+        readsFrom: {db.settings},
+      )
+      .watchSingle()
+      .map((r) => r.readNullable<String>('store_id'));
+});
+
+/// "N belum terkirim": products employees don't have yet. Null when the phone
+/// isn't connected to a store (then there is nothing to send to).
+final unsentCountProvider = StreamProvider<int?>((ref) {
+  final user = ref.watch(serverUserProvider).value;
+  if (user == null || user.isAnonymous) return Stream.value(null);
+  final db = ref.watch(ownerDbProvider);
+  return db
+      .customSelect(
+        'SELECT s.store_id AS store_id, '
+        '(SELECT COUNT(*) FROM products_to_publish) AS n '
+        'FROM settings s WHERE s.id = 1',
+        readsFrom: {db.settings, db.products, db.categories},
+      )
+      .watchSingle()
+      .map(
+        (r) => r.readNullable<String>('store_id') == null
+            ? null
+            : r.read<int>('n'),
+      );
+});
+
+/// Publishes in the background while the owner side of the app runs.
+final autoPublisherProvider = Provider<AutoPublisher?>((ref) {
+  if (ref.watch(serverApiProvider) == null) return null;
+  final publisher = AutoPublisher(
+    ref.watch(ownerDbProvider),
+    ref.watch(publishServiceProvider),
+  )..start();
+  ref.listen(serverUserProvider, (_, _) => publisher.kick());
+  ref.onDispose(publisher.dispose);
+  return publisher;
+});
+
+// ------------------------------------------------------------- employee side
+
+final employeeDbProvider = Provider<EmployeeDatabase>((ref) {
+  final db = EmployeeDatabase();
+  ref.onDispose(db.close);
+  return db;
+});
+
+final employeeCatalogRepositoryProvider = Provider<EmployeeCatalogRepository>(
+  (ref) => EmployeeCatalogRepository(ref.watch(employeeDbProvider)),
+);
+
+final employeeSessionStoreProvider = Provider<EmployeeSessionStore>(
+  (ref) => EmployeeSessionStore(ref.watch(keyValueStoreProvider)),
+);
+
+final employeeSyncServiceProvider = Provider<EmployeeSyncService>(
+  (ref) => EmployeeSyncService(
+    ref.watch(employeeCatalogRepositoryProvider),
+    ref.watch(serverApiProvider),
+    ref.watch(employeeSessionStoreProvider),
+  ),
+);
+
+final joinServiceProvider = Provider<JoinService>(
+  (ref) => JoinService(
+    ref.watch(serverApiProvider),
+    ref.watch(employeeSessionStoreProvider),
+    ref.watch(employeeCatalogRepositoryProvider),
+  ),
+);
