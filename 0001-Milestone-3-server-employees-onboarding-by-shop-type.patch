+                Padding(
+                  padding: const EdgeInsets.only(top: 6),
+                  child: Text(
+                    'Tekan lama emoji Anda untuk menghapusnya dari daftar.',
+                    style: text.bodySmall?.copyWith(color: Colors.black54),
