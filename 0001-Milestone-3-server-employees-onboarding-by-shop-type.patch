diff --git a/app/test/publish/publish_service_test.dart b/app/test/publish/publish_service_test.dart
new file mode 100644
index 0000000..5f68d7a
--- /dev/null
+++ b/app/test/publish/publish_service_test.dart
@@ -0,0 +1,156 @@
+import 'dart:convert';
+
+import 'package:drift/drift.dart' hide isNotNull, isNull;
+import 'package:drift/native.dart';
+import 'package:flutter_application_1/core/server_api.dart';
+import 'package:flutter_application_1/data/owner_database.dart';
+import 'package:flutter_application_1/products/product_service.dart';
+import 'package:flutter_application_1/publish/publish_service.dart';
+import 'package:flutter_application_1/team/owner_account_service.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+import '../support/fake_server_api.dart';
+
+void main() {
+  late OwnerDatabase db;
+  late ProductService products;
+  late FakeServerApi api;
+  late PublishService publish;
+  late String store;
+
+  setUp(() async {
+    db = OwnerDatabase(NativeDatabase.memory());
+    products = ProductService(db);
+    api = FakeServerApi();
+    publish = PublishService(db, api);
+    await api.signUp('budi@email.com', 'rahasia123');
+    await OwnerAccountService(db, api).createStore('Toko Berkah');
+    store = api.stores.keys.single;
+  });
+  tearDown(() => db.close());
+
+  Future<String> add(String name, {String? category}) => products.addManual(
+    NewProductInput(
+      name: name,
+      supplierName: 'CV Rahasia Supplier',
+      supplyPrice: 9500,
+      categoryName: category,
+      model: 'TC-100',
+    ),
+  );
+
+  Future<int> unsent() async => (await db
+          .customSelect('SELECT COUNT(*) AS n FROM products_to_publish')
+          .getSingle())
+      .read<int>('n');
+
+  test('payload has only the whitelisted fields and no supplier data', () async {
+    await add('Kabel Type C', category: 'Kabel');
+    final result = await publish.publish();
+
+    expect(result.outcome, PublishOutcome.sent);
+    expect(result.sent, 1);
+    final item = api.payloads.single.single;
+    expect(item.keys.toSet(), PublishService.allowedFields);
+    final json = jsonEncode(api.payloads);
+    expect(json, isNot(contains('Rahasia'))); // supplier name
+    expect(json, isNot(contains('9500'))); // supply price
+    expect(item['category'], 'Kabel');
+    expect(item['is_deleted'], false);
+    expect(await unsent(), 0);
+  });
+
+  test('published_at is the updated_at that was sent, not now', () async {
+    final id = await add('Kabel');
+    final before = (await db
+            .customSelect(
+              'SELECT updated_at FROM products WHERE id = ?',
+              variables: [Variable.withString(id)],
+            )
+            .getSingle())
+        .read<String>('updated_at');
+    await publish.publish();
+    final after = (await db
+            .customSelect(
+              'SELECT published_at FROM products WHERE id = ?',
+              variables: [Variable.withString(id)],
+            )
+            .getSingle())
+        .read<String>('published_at');
+    expect(after, before);
+  });
+
+  test('a product edited during the upload stays unsent', () async {
+    final id = await add('Kabel');
+    api.duringPublish = () async {
+      api.duringPublish = null;
+      // Make sure the new updated_at is later than the one being sent.
+      await Future<void>.delayed(const Duration(milliseconds: 5));
+      await products.setRetailOverride(id, 25000);
+    };
+    await publish.publish();
+    expect(await unsent(), 1);
+
+    final second = await publish.publish();
+    expect(second.sent, 1);
+    expect(api.payloads.last.single['retail_price'], 25000);
+    expect(await unsent(), 0);
+  });
+
+  test('sends in batches of 200', () async {
+    for (var i = 0; i < 450; i++) {
+      await add('Produk $i');
+    }
+    final result = await publish.publish();
+    expect(result.sent, 450);
+    expect(api.payloads.map((p) => p.length), [200, 200, 50]);
+  });
+
+  test('deleted products go out as is_deleted', () async {
+    final id = await add('Kabel');
+    await publish.publish();
+    await products.deleteProduct(id);
+    await publish.publish();
+    expect(api.payloads.last.single['is_deleted'], true);
+  });
+
+  test('offline: nothing is lost, it goes out next time', () async {
+    await add('Kabel');
+    api.offline = true;
+    final r = await publish.publish();
+    expect(r.outcome, PublishOutcome.offline);
+    expect(await unsent(), 1);
+
+    api.offline = false;
+    expect((await publish.publish()).outcome, PublishOutcome.sent);
+    expect(await unsent(), 0);
+  });
+
+  test('not connected: no store, signed out, or employee session', () async {
+    await add('Kabel');
+    await api.signOut();
+    expect(
+      (await publish.publish()).outcome,
+      PublishOutcome.notConnected,
+    );
+    await api.signInAnonymously();
+    expect(
+      (await publish.publish()).outcome,
+      PublishOutcome.notConnected,
+    );
+    expect(
+      (await PublishService(db, null).publish()).outcome,
+      PublishOutcome.notConnected,
+    );
+  });
+
+  test('another account is refused and nothing is marked sent', () async {
+    await add('Kabel');
+    await api.signIn('lain@email.com', 'rahasia123');
+    final r = await publish.publish();
+    expect(r.outcome, PublishOutcome.notAllowed);
+    expect(r.error?.kind, ServerErrorKind.notAllowed);
+    expect(await unsent(), 1);
+    expect(store, isNotEmpty);
+  });
+}
diff --git a/app/test/support/fake_server_api.dart b/app/test/support/fake_server_api.dart
new file mode 100644
index 0000000..05fe1da
--- /dev/null
+++ b/app/test/support/fake_server_api.dart
@@ -0,0 +1,221 @@
+import 'dart:async';
+
+import 'package:flutter_application_1/core/server_api.dart';
+
+/// In-memory stand-in for the Supabase server, following the rules of
+/// supabase/migrations/0001_init.sql: publish_catalog keeps only the
+/// whitelisted fields and stamps rows with one server time per call,
+/// employee_catalog returns rows after a cursor, oldest first, at most
+/// [maxRows] (like PostgREST's row limit), and revoked members are refused.
+class FakeServerApi implements ServerApi {
+  FakeServerApi({this.maxRows = 1000});
+
+  final int maxRows;
+
+  ServerUser? user;
+  bool offline = false;
+
+  /// Called inside publishCatalog, to simulate an edit during the upload.
+  Future<void> Function()? duringPublish;
+
+  final payloads = <List<Map<String, Object?>>>[];
+  final stores = <String, String>{}; // id -> name
+  final owners = <String, String>{}; // store id -> user id
+  final memberships = <String, Map<String, StoreMember>>{};
+  final catalog = <String, Map<String, Map<String, Object?>>>{};
+  final invites = <String, (String store, bool revoked)>{};
+  final _changes = StreamController<ServerUser?>.broadcast();
+  var _clock = 0;
+  var _ids = 0;
+
+  static const whitelist = {
+    'id',
+    'name',
+    'model',
+    'category',
+    'unit',
+    'photo_path',
+    'retail_price',
+    'is_deleted',
+  };
+
+  String _now() =>
+      DateTime.utc(2026, 10, 26, 8).add(Duration(seconds: _clock++)).toIso8601String();
+
+  void _check() {
+    if (offline) throw const ServerException(ServerErrorKind.offline);
+  }
+
+  void _requireUser() {
+    if (user == null) throw const ServerException(ServerErrorKind.notAllowed);
+  }
+
+  bool _isMember(String store) {
+    final u = user;
+    if (u == null) return false;
+    if (owners[store] == u.id) return true;
+    final m = memberships[store]?[u.id];
+    return m != null && m.isActive;
+  }
+
+  @override
+  ServerUser? get currentUser => user;
+
+  @override
+  Stream<ServerUser?> get userChanges => _changes.stream;
+
+  @override
+  Future<bool> signUp(String email, String password) async {
+    _check();
+    user = ServerUser(id: 'owner-$email', email: email, isAnonymous: false);
+    _changes.add(user);
+    return true;
+  }
+
+  @override
+  Future<void> signIn(String email, String password) async {
+    _check();
+    if (password != 'rahasia123') {
+      throw const ServerException(ServerErrorKind.invalidLogin);
+    }
+    user = ServerUser(id: 'owner-$email', email: email, isAnonymous: false);
+    _changes.add(user);
+  }
+
+  @override
+  Future<void> signInAnonymously() async {
+    _check();
+    user = ServerUser(id: 'anon-${_ids++}', isAnonymous: true);
+    _changes.add(user);
+  }
+
+  @override
+  Future<void> signOut() async {
+    user = null;
+    _changes.add(null);
+  }
+
+  @override
+  Future<String> createStore(String name) async {
+    _check();
+    _requireUser();
+    final id = '00000000-0000-4000-8000-${(_ids++).toString().padLeft(12, '0')}';
+    stores[id] = name;
+    owners[id] = user!.id;
+    return id;
+  }
+
+  @override
+  Future<String?> storeName(String storeId) async {
+    _check();
+    return _isMember(storeId) ? stores[storeId] : null;
+  }
+
+  @override
+  Future<bool> isOwnerOf(String storeId) async {
+    _check();
+    return user != null && owners[storeId] == user!.id;
+  }
+
+  @override
+  Future<int> publishCatalog(
+    String storeId,
+    List<Map<String, Object?>> items,
+  ) async {
+    _check();
+    if (user == null || owners[storeId] != user!.id) {
+      throw const ServerException(ServerErrorKind.notAllowed);
+    }
+    payloads.add(items);
+    await duringPublish?.call();
+    final at = _now();
+    final rows = catalog.putIfAbsent(storeId, () => {});
+    for (final i in items) {
+      rows[i['id'] as String] = {
+        for (final k in whitelist) k: i[k],
+        'unit': i['unit'] ?? 'pcs',
+        'is_deleted': i['is_deleted'] ?? false,
+        'updated_at': at,
+      };
+    }
+    return items.length;
+  }
+
+  @override
+  Future<List<CatalogRow>> employeeCatalog(
+    String storeId, {
+    String? since,
+  }) async {
+    _check();
+    if (!_isMember(storeId)) {
+      throw const ServerException(ServerErrorKind.notAllowed);
+    }
+    final rows =
+        (catalog[storeId]?.values.toList() ?? [])
+            .where(
+              (r) =>
+                  since == null ||
+                  (r['updated_at'] as String).compareTo(since) > 0,
+            )
+            .toList()
+          ..sort(
+            (a, b) =>
+                (a['updated_at'] as String).compareTo(b['updated_at'] as String),
+          );
+    return [
+      for (final r in rows.take(maxRows))
+        CatalogRow.fromJson(Map<String, dynamic>.from(r)),
+    ];
+  }
+
+  @override
+  Future<String> createInvite(String storeId) async {
+    _check();
+    final code = 'KODE${(_ids++).toString().padLeft(4, '0')}';
+    invites[code] = (storeId, false);
+    return code;
+  }
+
+  @override
+  Future<String> acceptInvite(
+    String code, {
+    required String name,
+    required String device,
+  }) async {
+    _check();
+    _requireUser();
+    final inv = invites[code.toUpperCase()];
+    if (inv == null || inv.$2) {
+      throw const ServerException(ServerErrorKind.inviteInvalid);
+    }
+    memberships.putIfAbsent(inv.$1, () => {})[user!.id] = StoreMember(
+      userId: user!.id,
+      displayName: name,
+      deviceLabel: device,
+      joinedAt: DateTime.utc(2026, 10, 26),
+    );
+    return inv.$1;
+  }
+
+  @override
+  Future<List<StoreMember>> members(String storeId) async =>
+      memberships[storeId]?.values.toList() ?? [];
+
+  @override
+  Future<void> revokeMember(String storeId, String userId) async {
+    final m = memberships[storeId]![userId]!;
+    memberships[storeId]![userId] = StoreMember(
+      userId: m.userId,
+      displayName: m.displayName,
+      deviceLabel: m.deviceLabel,
+      joinedAt: m.joinedAt,
+      revokedAt: DateTime.utc(2026, 10, 27),
+    );
+  }
+
+  @override
+  Future<List<StoreInvite>> activeInvites(String storeId) async => [];
+
+  @override
+  Future<void> revokeInvite(String inviteId) async {}
+}
diff --git a/app/test/team/owner_account_service_test.dart b/app/test/team/owner_account_service_test.dart
new file mode 100644
index 0000000..55f9f20
