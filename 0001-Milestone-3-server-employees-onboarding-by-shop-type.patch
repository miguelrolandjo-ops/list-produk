+                  if (expanded) {
+                    return GridView.builder(
+                      padding: const EdgeInsets.fromLTRB(16, 0, 16, 32),
+                      gridDelegate:
+                          const SliverGridDelegateWithMaxCrossAxisExtent(
+                            maxCrossAxisExtent: 300,
+                            mainAxisExtent: 132,
+                            mainAxisSpacing: 12,
